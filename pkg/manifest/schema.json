{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cargoship.app/schema/manifest-2.0.json",
  "title": "CargoShip Manifest",
  "description": "Schema for a CargoShip upload manifest (manifest.json[.gz]). See docs/reference/format/manifest.md. This schema is drift-checked against pkg/manifest/types.go by TestSchemaMatchesStructs (#274).",
  "type": "object",
  "required": [
    "version",
    "upload_id",
    "created_at",
    "completed_at",
    "source_path",
    "hostname",
    "bucket",
    "prefix",
    "region",
    "total_files",
    "total_bytes",
    "total_chunks",
    "shard_count",
    "compression_type",
    "compression_level",
    "compression_ratio",
    "files",
    "chunks",
    "shards"
  ],
  "properties": {
    "version": { "type": "string", "description": "Manifest format version (\"2.0\" current, \"1.0\" read-compatible)." },
    "upload_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "source_path": { "type": "string" },
    "hostname": { "type": "string" },
    "previous_manifest_id": { "type": "string" },
    "sync_type": { "type": "string" },
    "bucket": { "type": "string" },
    "prefix": { "type": "string" },
    "region": { "type": "string" },
    "total_files": { "type": "integer" },
    "total_bytes": { "type": "integer" },
    "total_chunks": { "type": "integer" },
    "shard_count": { "type": "integer" },
    "compression_type": { "type": "string" },
    "compression_level": { "type": "integer" },
    "compression_ratio": { "type": "number" },
    "checksum_algorithm": { "type": "string", "description": "Hash for chunk/file checksums, e.g. \"sha256\" (#271)." },
    "encryption": { "type": ["object", "null"] },
    "deduplication": { "type": ["object", "null"] },
    "version_info": { "type": ["object", "null"] },
    "git_metadata": { "type": ["object", "null"] },
    "dvc_compatibility": { "type": ["object", "null"] },
    "dvc_pipeline": { "type": ["object", "null"] },
    "files": { "type": "array", "items": { "$ref": "#/definitions/fileEntry" } },
    "chunks": { "type": "array", "items": { "$ref": "#/definitions/chunkEntry" } },
    "shards": { "type": "array", "items": { "$ref": "#/definitions/shardEntry" } }
  },
  "definitions": {
    "fileEntry": {
      "type": "object",
      "required": ["path", "size", "mod_time", "chunk_id", "shard_id", "s3_key"],
      "properties": {
        "path": { "type": "string" },
        "size": { "type": "integer" },
        "mod_time": { "type": "string", "format": "date-time" },
        "chunk_id": { "type": "integer" },
        "shard_id": { "type": "integer" },
        "s3_key": { "type": "string" },
        "offset": { "type": "integer" },
        "length": { "type": "integer" },
        "part_index": { "type": "integer" },
        "total_parts": { "type": "integer" },
        "checksum": { "type": "string" },
        "content_hash": { "type": "string" },
        "metadata": { "type": ["object", "null"] },
        "dvc_metadata": { "type": ["object", "null"] },
        "is_duplicate": { "type": "boolean" },
        "duplicate_of_hash": { "type": "string" },
        "original_chunk_id": { "type": "integer" },
        "original_shard_id": { "type": "integer" },
        "original_s3_key": { "type": "string" },
        "deduplication_refs": { "type": "integer" }
      }
    },
    "chunkEntry": {
      "type": "object",
      "required": ["id", "shard_id", "s3_key", "file_count", "file_paths", "uncompressed_size", "compressed_size", "created_at", "uploaded_at"],
      "properties": {
        "id": { "type": "integer" },
        "shard_id": { "type": "integer" },
        "s3_key": { "type": "string" },
        "file_count": { "type": "integer" },
        "file_paths": { "type": "array", "items": { "type": "string" } },
        "uncompressed_size": { "type": "integer" },
        "compressed_size": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "uploaded_at": { "type": "string", "format": "date-time" },
        "checksum": { "type": "string" }
      }
    },
    "shardEntry": {
      "type": "object",
      "required": ["id", "prefix", "chunk_count", "file_count", "uncompressed_size", "compressed_size", "chunk_keys"],
      "properties": {
        "id": { "type": "integer" },
        "prefix": { "type": "string" },
        "chunk_count": { "type": "integer" },
        "file_count": { "type": "integer" },
        "uncompressed_size": { "type": "integer" },
        "compressed_size": { "type": "integer" },
        "chunk_keys": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
