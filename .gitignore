# Archive directory (historical docs not tracked in repo)
docs/archive/
.archive/

# macOS Finder metadata. Unignored until now, so simply opening a directory in
# Finder could stage a .DS_Store into a commit -- which is exactly how one reached
# a docs commit. Matched at any depth.
.DS_Store

# Temporary development artifacts
temp_*
working_*
# Anchored to the REPO ROOT on purpose. `public/` (unanchored) also matched
# docs/public/, the VitePress static-asset source directory, so the site's logo,
# hero image, OG card and CNAME were never committed: the site built fine locally
# and shipped with all three images 404 on cargoship.app. The root ./public/ this
# is actually for is a stale generated site tree (404.html, sitemap.xml, ...).
/public/
site/

# Quality reports (generated artifacts)
reports/

# Profiling data (generated artifacts)
profiles/benchmarks/*.prof
profiles/benchmarks/*.out
profiles/reports/*.txt
profiles/reports/*.svg
profiles/baselines/*.json
profiles/baselines/*.txt
benchmark-current.txt

# Local secrets / environment (never commit)
.env
.env.*
!.env.example
.claude/worktrees/
