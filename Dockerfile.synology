# CargoShip Ghost Ship for Synology NAS Container Manager
# Generic Synology DSM deployment optimized for autonomous archival operations
FROM golang:1.23-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the ghost ship binary with optimizations
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -tags netgo \
    -o ghost-ship \
    ./cmd/ghost-ship

# Build the test binary for validation
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -tags netgo \
    -o cargoship-test \
    ./cmd/cargoship-test

# Final runtime image
FROM alpine:3.18

# Install runtime dependencies for Synology operations
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    aws-cli \
    inotify-tools \
    bash \
    htop \
    iftop \
    tcpdump \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Create Synology-compatible user and groups
# Synology typically uses uid=1027(dockerlimited) gid=65537(dockergroup)
# We'll create flexible groups that can be mapped via docker-compose user directive
RUN addgroup -g 65537 dockergroup && \
    adduser -D -s /bin/sh -u 1027 -G dockergroup cargoship

# Create directory structure for Synology
RUN mkdir -p \
    /var/log/cargoship \
    /var/lib/cargoship \
    /tmp/cargoship \
    /data/public \
    /etc/cargoship \
    /results && \
    chown -R cargoship:dockergroup \
        /var/log/cargoship \
        /var/lib/cargoship \
        /tmp/cargoship \
        /results

# Copy binaries from builder
COPY --from=builder /build/ghost-ship /usr/local/bin/ghost-ship
COPY --from=builder /build/cargoship-test /usr/local/bin/cargoship-test

# Skip copying Synology-specific configuration (optional)
# COPY --from=builder /build/configs/synology/ /etc/cargoship/

# Make binaries executable
RUN chmod +x /usr/local/bin/ghost-ship /usr/local/bin/cargoship-test

# Create startup script for Synology
RUN echo '#!/bin/bash' > /usr/local/bin/synology-startup.sh && \
    echo 'set -euo pipefail' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "🚢 CargoShip Ghost Ship starting on Synology NAS"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "📊 System Information:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "  - Host: $(hostname)"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "  - Date: $(date)"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "  - User: $(whoami) ($(id))"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "  - CPU: $(nproc) cores"' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "  - Platform: Synology DSM Container Manager"' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo '# Check network connectivity' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "🌐 Network Status:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'ping -c 1 8.8.8.8 >/dev/null 2>&1 && echo "  - Internet: ✅" || echo "  - Internet: ❌"' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo '# Check AWS connectivity' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "☁️ AWS S3 Status:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'aws s3 ls >/dev/null 2>&1 && echo "  - S3 Access: ✅" || echo "  - S3 Access: ❌ (check credentials)"' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo '# Check data directory access' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "📁 Data Access:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'if [ -d "/data/public" ]; then' >> /usr/local/bin/synology-startup.sh && \
    echo '    count=$(find /data/public -type f 2>/dev/null | wc -l || echo "0")' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - /data/public: ✅ ($count files)"' >> /usr/local/bin/synology-startup.sh && \
    echo '    # Test write permissions to working directories' >> /usr/local/bin/synology-startup.sh && \
    echo '    touch /tmp/cargoship/.write-test 2>/dev/null && rm -f /tmp/cargoship/.write-test && echo "  - Working dir: ✅ (writable)" || echo "  - Working dir: ❌ (permission denied)"' >> /usr/local/bin/synology-startup.sh && \
    echo 'else' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - /data/public: ❌ Not mounted"' >> /usr/local/bin/synology-startup.sh && \
    echo 'fi' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo '# Check Synology volume access' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "💾 Synology Volume Status:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'if [ -d "/var/log/cargoship" ]; then' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - Log directory: ✅ (/var/log/cargoship)"' >> /usr/local/bin/synology-startup.sh && \
    echo 'else' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - Log directory: ❌ Not mounted"' >> /usr/local/bin/synology-startup.sh && \
    echo 'fi' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo '# Check configuration' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "⚙️ Configuration:"' >> /usr/local/bin/synology-startup.sh && \
    echo 'config_file="${CARGOSHIP_CONFIG_FILE:-/etc/cargoship/ghost_ship.yaml}"' >> /usr/local/bin/synology-startup.sh && \
    echo 'if [ -f "$config_file" ]; then' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - Config: ✅ $config_file"' >> /usr/local/bin/synology-startup.sh && \
    echo 'else' >> /usr/local/bin/synology-startup.sh && \
    echo '    echo "  - Config: ❌ Missing $config_file"' >> /usr/local/bin/synology-startup.sh && \
    echo '    exit 1' >> /usr/local/bin/synology-startup.sh && \
    echo 'fi' >> /usr/local/bin/synology-startup.sh && \
    echo '' >> /usr/local/bin/synology-startup.sh && \
    echo 'echo "🚀 Launching Ghost Ship..."' >> /usr/local/bin/synology-startup.sh && \
    echo 'exec ghost-ship "$@"' >> /usr/local/bin/synology-startup.sh

RUN chmod +x /usr/local/bin/synology-startup.sh

# Set environment variables optimized for Synology
ENV GOMAXPROCS=0 \
    GOGC=100 \
    CARGOSHIP_LOG_LEVEL=info \
    CARGOSHIP_CONFIG_FILE=/etc/cargoship/ghost_ship.yaml \
    CARGOSHIP_METRICS_PORT=9090 \
    CARGOSHIP_NETWORK_OPTIMIZE=true \
    AWS_DEFAULT_REGION=us-east-1

# Expose metrics port
EXPOSE 9090

# Health check optimized for Synology
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:9090/health || exit 1

# Switch to Synology-compatible user (uid=1027, gid=65537)
USER cargoship

# Default working directory
WORKDIR /var/lib/cargoship

# Labels for identification
LABEL org.cargoship.component="ghost-ship"
LABEL org.cargoship.deployment="synology"
LABEL org.cargoship.platform="synology-container-manager"
LABEL org.cargoship.version="latest"

# Use startup script as entrypoint
ENTRYPOINT ["/usr/local/bin/synology-startup.sh"]
CMD ["--config", "/etc/cargoship/ghost_ship.yaml", "--log-level", "info"]