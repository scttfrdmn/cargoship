# Multi-stage build for CargoShip Launch Agent
FROM golang:1.23-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the launch agent
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o cargoship-launch \
    ./cmd/cargoship-launch

# Production image
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    bash

# Create non-root user
RUN addgroup -g 1000 cargoship && \
    adduser -D -s /bin/bash -u 1000 -G cargoship cargoship

# Create directories
RUN mkdir -p /config /data /logs && \
    chown -R cargoship:cargoship /config /data /logs

# Copy binary from builder
COPY --from=builder /build/cargoship-launch /usr/local/bin/cargoship-launch
RUN chmod +x /usr/local/bin/cargoship-launch

# Copy default configuration
COPY --chown=cargoship:cargoship docker/launch/agent.yaml /config/agent.yaml

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD cargoship-launch -validate || exit 1

# Switch to non-root user
USER cargoship

# Set working directory
WORKDIR /home/cargoship

# Default configuration path
ENV CARGOSHIP_CONFIG_PATH=/config/agent.yaml

# Expose any necessary ports (none for headless agent)

# Default command
CMD ["cargoship-launch", "-config", "/config/agent.yaml"]

# Labels
LABEL maintainer="CargoShip Team"
LABEL version="0.3.0"
LABEL description="CargoShip Launch Agent for NAS deployment"
LABEL org.opencontainers.image.title="CargoShip Launch Agent"
LABEL org.opencontainers.image.description="Headless agent for intelligent research data archival"
LABEL org.opencontainers.image.url="https://cargoship.dev"
LABEL org.opencontainers.image.source="https://github.com/scttfrdmn/cargoship"
LABEL org.opencontainers.image.version="0.3.0"